# URL nội bộ tới API. FE gọi API ở server-side (src/lib/api/server-client.ts),
# trình duyệt không bao giờ thấy giá trị này — nên KHÔNG dùng NEXT_PUBLIC_*.
#
# local:    http://localhost:3000
# staging:  http://api:3000   (tên service trong compose stack)
# prod:     http://api:3000
#
# Ở production mà thiếu biến này thì app log cảnh báo và fallback về localhost.
API_URL=http://localhost:3000
