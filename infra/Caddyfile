# Caddy giữ :80/:443 và tự xin/gia hạn Let's Encrypt. Không certbot, không cron.
# Giá trị {$...} đọc từ /srv/crm-koc/edge/.env.

{
	email {$ACME_EMAIL}
}

# --- production ---
{$PROD_APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy web-prod:3000
}

{$PROD_API_DOMAIN} {
	encode zstd gzip
	# Upload KYC có thể lớn; giữ khớp KYC_MAX_FILE_SIZE_BYTES.
	request_body {
		max_size 12MB
	}
	reverse_proxy api-prod:3000
}

# --- staging ---
{$STAGING_APP_DOMAIN} {
	encode zstd gzip
	# Staging không được để bot index.
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy web-staging:3000
}

{$STAGING_API_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 12MB
	}
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy api-staging:3000
}

# --- monitoring ---
{$STATUS_DOMAIN} {
	reverse_proxy uptime-kuma:3001
}
