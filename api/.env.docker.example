# Template env cho Docker Compose ở MÁY LOCAL. Copy thành .env.docker rồi điền
# secret:  cp .env.docker.example .env.docker
#
# Server staging/prod KHÔNG dùng file này — .env ở đó do workflow deploy ghi
# xuống từ GitHub Environment secrets (xem docs/deployment/secrets.md).
#
# Lưu ý: không viết comment ở cuối dòng giá trị — Compose không cắt phần đó ra
# như dotenv, giá trị sẽ dính cả comment.

NODE_ENV=production
PORT=3000

# --- Cổng expose ra máy host (đổi nếu bị trùng với dịch vụ đang chạy sẵn) ---
HOST_API_PORT=3000
HOST_DB_PORT=5432
HOST_REDIS_PORT=6379

# --- Postgres ---
# DATABASE_HOST/PORT bị compose ghi đè thành postgres:5432, khai báo ở đây chỉ
# để chạy ngoài Docker. Username/password/name được dùng cho CẢ service postgres
# lẫn app, nên sửa là sửa một chỗ.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=crm_koc
DATABASE_SSL_ENABLED=false

# Ba biến dưới là để KHỞI TẠO container postgres, phải khớp đúng với ba biến
# DATABASE_USERNAME/PASSWORD/NAME ở trên. Đổi sau khi volume đã tạo thì không
# có tác dụng, phải `docker compose down -v` rồi dựng lại.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crm_koc

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Service redis trong compose không bật requirepass, để trống.
REDIS_PASSWORD=

# --- CORS ---
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true

# --- JWT: hai secret PHẢI khác nhau ---
# Sinh: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ACCESS_TOKEN_EXPIRES_IN=15m

# --- Phiên trong Redis ---
SESSION_TTL_SECONDS=604800
SESSION_ABSOLUTE_TTL_SECONDS=604800
SESSION_MAX_PER_USER=10
SESSION_MAX_PER_ADMIN=3
SESSION_TOUCH_INTERVAL_SECONDS=300

# --- OTP ---
OTP_TTL_SECONDS=300
OTP_LOCK_TTL_SECONDS=900
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5
OTP_RESEND_WINDOW_SECONDS=3600

# --- System config ---
SYSTEM_CONFIG_CACHE_TTL_SECONDS=300

# --- Social OAuth ---
# Khoá AES-256-GCM, 32 byte base64:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_OAUTH_CALLBACK_BASE_URL=http://localhost:3001/social/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Email ---
SENDGRID_API_KEY=
SENDGRID_FROM=CRM-KOC System <no-reply@crm-koc.asia>

# --- Object storage ---
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=

# --- KYC ---
KYC_MAX_FILE_SIZE_BYTES=10485760

# --- Migration ---
# CHỈ dùng cho dev local (target `dev`). Trên staging/prod migration chạy bằng
# service one-shot `api-migrate`, biến này phải để false hoặc không set.
RUN_MIGRATIONS=true
