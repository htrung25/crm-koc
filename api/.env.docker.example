# Template env cho Docker Compose. Copy thành .env.docker rồi điền secret:
#   cp .env.docker.example .env.docker
# Lưu ý: không viết comment ở cuối dòng giá trị — Compose không cắt phần đó ra
# như dotenv, giá trị sẽ dính cả comment.

NODE_ENV=production
PORT=3000

# --- Cổng expose ra máy host (đổi nếu bị trùng với dịch vụ đang chạy sẵn) ---
HOST_API_PORT=3000
HOST_DB_PORT=5432
HOST_REDIS_PORT=6379

# --- Postgres ---
# DATABASE_HOST/PORT bị compose ghi đè thành postgres:5432, khai báo ở đây chỉ
# để chạy ngoài Docker. Username/password/name được dùng cho CẢ service postgres
# lẫn app, nên sửa là sửa một chỗ.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=crm_koc
DATABASE_SSL_ENABLED=false

# Ba biến dưới là để KHỞI TẠO container postgres, phải khớp đúng với ba biến
# DATABASE_USERNAME/PASSWORD/NAME ở trên. Đổi sau khi volume đã tạo thì không
# có tác dụng, phải `docker compose down -v` rồi dựng lại.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crm_koc

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# Service redis trong compose không bật requirepass, để trống.
REDIS_PASSWORD=

# --- CORS ---
# Danh sách origin ngăn cách bằng dấu phẩy, hoặc * để cho tất cả.
CORS_ORIGIN=http://localhost:3001
CORS_CREDENTIALS=true

# --- JWT: hai secret PHẢI khác nhau ---
# Sinh: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Cookie / session ---
COOKIE_SECRET=
SESSION_SECRET=
SESSION_NAME=session_auth
SESSION_DOMAIN=localhost
SESSION_MAX_AGE=86400000
SESSION_HTTP_ONLY=false
SESSION_SECURE=false
SESSION_FOLDER=sessions_dev
SESSION_SAME_SITE=lax

# --- Social OAuth ---
# Khoá AES-256-GCM, 32 byte base64:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_OAUTH_CALLBACK_BASE_URL=http://localhost:3001/social/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Email ---
SENDGRID_API_KEY=

# --- Migration ---
# Đặt false nếu muốn tự chạy `docker compose run --rm api npm run migration:run`.
RUN_MIGRATIONS=true
