NODE_ENV=development
PORT=3000

# Postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_NAME=crm_koc
DATABASE_SSL_ENABLED=false

# Nếu set, DATABASE_URL sẽ được ưu tiên hơn các biến DATABASE_* ở trên
# DATABASE_URL=postgres://user:password@host:5432/crm_koc

# --- Social OAuth ---
# Khoá AES-256-GCM mã hoá token của nền tảng, 32 byte dạng base64.
# Sinh mới: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Gốc URL trang callback Ở FRONTEND (không phải API): nền tảng chuyển hướng
# trình duyệt tới đây, trang này đọc code+state rồi mới gọi API kèm token.
# Đường dẫn cuối cùng là <base>/<platform>, ví dụ .../social/callback/tiktok
SOCIAL_OAUTH_CALLBACK_BASE_URL=http://localhost:3001/social/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
