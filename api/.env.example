NODE_ENV=development
PORT=3000

# Postgres (local homebrew postgresql@17, pg_hba = trust)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=admin
DATABASE_PASSWORD=
DATABASE_NAME=crm_koc
DATABASE_SSL_ENABLED=false

# Nếu set, DATABASE_URL sẽ được ưu tiên hơn các biến DATABASE_* ở trên
# DATABASE_URL=postgres://admin@localhost:5432/crm_koc

# JWT
JWT_SECRET=25f38c6628cb3e9d09cdbed8beb2f0078e19e442f9a5d4475a10c86820021ff8

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Cấu hình cookie 
COOKIE_SECRET=secret            # Khóa để ký/xác minh cookie (ngăn chặn giả mạo) 
SESSION_SECRET=secret           # Bí mật để ký cookie ID phiên 
SESSION_NAME=session_auth       # Tên của cookie phiên 
SESSION_DOMAIN=localhost        # Tên miền nơi cookie hợp lệ 
SESSION_MAX_AGE=86400000        # Thời gian tồn tại của phiên tính bằng mili giây (ví dụ: 1 ngày) 
SESSION_HTTP_ONLY=false         # Nếu được đặt thành true, nó sẽ ngăn JavaScript phía máy khách truy cập cookie 
SESSION_SECURE=false            # Chỉ gửi cookie qua HTTPS (được đặt thành true trong môi trường sản xuất) 
SESSION_FOLDER=sessions_dev   # Đường dẫn để lưu trữ dữ liệu phiên (nếu dựa trên tệp) 
SESSION_SAME_SITE=lax           # Kiểm soát xem trình duyệt có gửi cookie cùng với các yêu cầu liên trang hay không. 

# JWT: hai secret PHẢI khác nhau
JWT_ACCESS_SECRET=bb4e37ecddf5fca99d10644a3ae6a01745d33edde11572adaff8c6d563b2c73f
JWT_REFRESH_SECRET=0086906d479037122c7c331e7dafaf42c8a38795d3ac24acc9e24c71f5755d09
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Phiên Redis (SessionService). KHÔNG liên quan tới nhóm SESSION_* ở trên —
# nhóm đó là cấu hình cookie, SessionService không đọc biến nào trong đó.
SESSION_TTL_SECONDS=604800              # 7 ngày, phải khớp JWT_REFRESH_TTL
SESSION_ABSOLUTE_TTL_SECONDS=604800     # trần cứng kể từ lúc đăng nhập
SESSION_MAX_PER_USER=10                 # brand/creator: số phiên đồng thời
SESSION_MAX_PER_ADMIN=3                 # admin siết chặt hơn

#System Config
SYSTEM_CONFIG_CACHE_TTL_SECONDS=300

# --- Social OAuth ---
SOCIAL_TOKEN_ENCRYPTION_KEY=pxgsKfVCWSmbXWqczi/LVqFYWNdhwogk9p/P0QYU4G8=
SOCIAL_OAUTH_CALLBACK_BASE_URL=http://localhost:3001/social/callback
TIKTOK_CLIENT_KEY=awb5j08f32ycsipd     #tiktok client_key từ tiktokdeveloper
TIKTOK_CLIENT_SECRET=vhz8LzoJXOq9QSmAJBkt3U5CIiweJAXY     #tiktok client_secret từ tiktokdeveloper

# Object storage (R2 hoặc S3 — cùng @aws-sdk/client-s3, khác nhau ở cấu hình)
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
KYC_DOC_RETENTION_DAYS=7
KYC_MAX_FILE_SIZE_BYTES=10485760
KYC_IMAGE_MAX_WIDTH=1920
