NODE_ENV=development
PORT=3000

# --- Postgres ---
# Ưu tiên DATABASE_URL nếu được set; nếu không thì dùng nhóm DATABASE_* bên dưới.
# DATABASE_URL=postgres://admin@localhost:5432/crm_koc
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=admin
DATABASE_PASSWORD=
DATABASE_NAME=crm_koc
DATABASE_SSL_ENABLED=false

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- CORS ---
# '*' chỉ dùng cho dev. Staging/prod đặt danh sách origin, ngăn cách bằng dấu phẩy.
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# --- JWT: hai secret PHẢI khác nhau ---
JWT_ACCESS_SECRET=bb4e37ecddf5fca99d10644a3ae6a01745d33edde11572adaff8c6d563b2c73f
JWT_REFRESH_SECRET=0086906d479037122c7c331e7dafaf42c8a38795d3ac24acc9e24c71f5755d09
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# expiresIn của JwtModule (SecurityModule). Giữ khớp với JWT_ACCESS_TTL.
JWT_ACCESS_TOKEN_EXPIRES_IN=15m

# --- Phiên trong Redis (SessionService) ---
SESSION_TTL_SECONDS=604800              # 7 ngày, phải khớp JWT_REFRESH_TTL
SESSION_ABSOLUTE_TTL_SECONDS=604800     # trần cứng kể từ lúc đăng nhập
SESSION_MAX_PER_USER=10                 # brand/creator: số phiên đồng thời
SESSION_MAX_PER_ADMIN=3                 # admin siết chặt hơn
SESSION_TOUCH_INTERVAL_SECONDS=300      # giãn cách ghi lại lastSeen

# --- OTP ---
OTP_TTL_SECONDS=300
OTP_LOCK_TTL_SECONDS=900
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5
OTP_RESEND_WINDOW_SECONDS=3600

# --- Email (SendGrid) ---
# Thiếu SENDGRID_API_KEY thì app vẫn chạy nhưng không gửi được mail.
SENDGRID_API_KEY=
SENDGRID_FROM=CRM-KOC System <no-reply@crm-koc.asia>

# --- System config ---
SYSTEM_CONFIG_CACHE_TTL_SECONDS=300

# --- Swagger ---
# Bỏ trống: mở khi NODE_ENV != production, đóng khi = production.
SWAGGER_ENABLED=

# --- Social OAuth ---
SOCIAL_TOKEN_ENCRYPTION_KEY=pxgsKfVCWSmbXWqczi/LVqFYWNdhwogk9p/P0QYU4G8=
SOCIAL_OAUTH_CALLBACK_BASE_URL=http://localhost:3001/social/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Object storage (R2 hoặc S3 — cùng @aws-sdk/client-s3, khác cấu hình) ---
STORAGE_ENDPOINT=  #https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=

# --- KYC ---
KYC_MAX_FILE_SIZE_BYTES=10485760

# --- Queue / worker ---
# Hạn hiệu lực của hồ sơ KYC đã duyệt, tính từ lúc admin duyệt.
KYC_VALIDITY_DAYS=365
# Object đã tạo mà chưa dòng DB nào tham chiếu sau ngần này phút thì sweep dọn.
STORAGE_SWEEP_PENDING_GRACE_MINUTES=60
