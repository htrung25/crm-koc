              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "OTP is wrong or has expired"
          },
          "403": {
            "description": "OTP is locked, or the account is suspended or banned"
          }
        },
        "summary": "Verify the login OTP and receive a JWT token",
        "tags": [
          "Auth"
        ]
      }
    },
    "/resend-otp": {
      "post": {
        "operationId": "AuthController_resendOtp",
