{
  "openapi": "3.0.0",
  "paths": {
    "/register": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Thiếu email hoặc password"
          },
          "409": {
            "description": "Email hoặc phone đã tồn tại"
          }
        },
        "summary": "Đăng ký account mới",
        "tags": [
          "auth"
        ]
      }
    },
    "/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Sai email hoặc password"
          },
          "403": {
            "description": "Account bị suspended hoặc banned"
          }
        },
        "summary": "Đăng nhập, trả về JWT access token",
        "tags": [
          "auth"
        ]
      }
    }
  },
  "info": {
    "title": "CRM KOC API",
    "description": "API cho hệ thống CRM KOC",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "EAccountRole": {
        "type": "string",
        "enum": [
          "admin",
          "brand",
          "creator"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "brand01@test.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "example": "secret123",
            "minLength": 6,
            "format": "password"
          },
          "phone": {
            "type": "string",
            "example": "0900000001",
            "maxLength": 10
          },
          "accountRole": {
            "default": "admin",
            "allOf": [
              {
                "$ref": "#/components/schemas/EAccountRole"
              }
            ]
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "EAccountStatus": {
        "type": "string",
        "enum": [
          "pending",
          "active",
          "suspended",
          "banned"
        ]
      },
      "RegisterResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "accountRole": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EAccountRole"
              }
            ]
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EAccountStatus"
              }
            ]
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "emailVerifiedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "phoneVerifiedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "statusReason": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "accountRole",
          "status",
          "phone",
          "emailVerifiedAt",
          "phoneVerifiedAt",
          "statusReason",
          "createdAt",
          "updatedAt"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "brand01@test.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "example": "secret123",
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthAccountDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "accountRole": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EAccountRole"
              }
            ]
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EAccountStatus"
              }
            ]
          }
        },
        "required": [
          "id",
          "email",
          "accountRole",
          "status"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT bearer token"
          },
          "account": {
            "$ref": "#/components/schemas/AuthAccountDto"
          }
        },
        "required": [
          "access_token",
          "account"
        ]
      }
    }
  }
}