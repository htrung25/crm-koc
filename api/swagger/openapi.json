{
  "openapi": "3.0.0",
  "paths": {
    "/admin/profile/me": {
      "get": {
        "operationId": "ProfileController_getMe",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Token is missing, invalid or expired"
          },
          "404": {
            "description": "Account has no profile yet"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Profile of the authenticated account",
        "tags": [
          "Admin-Profile"
        ]
      },
      "patch": {
        "operationId": "ProfileController_updateMe",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Token is missing, invalid or expired"
          },
          "404": {
            "description": "Account has no profile yet"
          },
          "409": {
            "description": "Email already taken by another account"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Partially update your own profile",
        "tags": [
          "Admin-Profile"
        ]
      }
    },
    "/register": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Missing name, email or password"
          },
          "409": {
            "description": "Email or phone already exists"
          }
        },
        "summary": "Register a new account",
        "tags": [
          "Auth"
        ]
      }
    },
    "/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Wrong email or password"
          },
          "403": {
            "description": "Account is suspended or banned"
          }
        },
        "summary": "Log in and receive a JWT access token",
        "tags": [
          "Auth"
        ]
      }
    },
    "/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Token is missing, invalid or expired"
          },
          "403": {
            "description": "Account is suspended or banned"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Account attached to the current token",
        "tags": [
          "Auth"
        ]
      }
    }
  },
  "info": {
    "title": "CRM KOC API",
    "description": "REST API for the CRM KOC system",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ProfileResponseDto": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid",
            "description": "Same value as accounts.id"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "maxLength": 255
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "address": {
            "type": "string",
            "nullable": true
          },
          "gender": {
            "type": "number",
            "nullable": true,
            "description": "1 = male, 2 = female, 3 = other"
          },
          "timezone": {
            "type": "string",
            "example": "Asia/Ho_Chi_Minh"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "accountId",
          "name",
          "email",
          "avatarUrl",
          "address",
          "gender",
          "timezone",
          "updatedAt"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "object",
            "example": "John Doe",
            "maxLength": 255
          },
          "email": {
            "type": "string",
            "example": "admin@gmail.com",
            "format": "email"
          },
          "avatarUrl": {
            "type": "object",
            "example": "https://cdn.example.com/a.png"
          },
          "address": {
            "type": "object",
            "example": "12 Nguyen Hue St, District 1, Ho Chi Minh City"
          },
          "gender": {
            "type": "number",
            "example": 1,
            "description": "1 = male, 2 = female, 3 = other"
          },
          "timezone": {
            "type": "string",
            "example": "Asia/Ho_Chi_Minh",
            "maxLength": 64
          }
        }
      },
      "EAccountRole": {
        "type": "string",
        "enum": [
          "admin",
          "brand",
          "creator"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Huu Trung",
            "maxLength": 255
          },
          "email": {
            "type": "string",
            "example": "admin@gmail.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "example": "abc@123",
            "minLength": 6,
            "format": "password"
          },
          "phone": {
            "type": "string",
            "example": "0900000001",
            "maxLength": 20,
            "description": "Vietnamese number. Accepts 0xxxxxxxxx / 84xxxxxxxxx / +84xxxxxxxxx and is normalized to E.164 (+84xxxxxxxxx) before saving."
          },
          "accountRole": {
            "default": "admin",
            "allOf": [
              {
                "$ref": "#/components/schemas/EAccountRole"
              }
            ]
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "EAccountStatus": {
        "type": "string",
        "enum": [
          "pending",
          "active",
          "suspended",
          "banned"
        ]
      },
      "RegisterResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "accountRole": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EAccountRole"
              }
            ]
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EAccountStatus"
              }
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "emailVerifiedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "phoneVerifiedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "statusReason": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "accountRole",
          "status",
          "name",
          "phone",
          "emailVerifiedAt",
          "phoneVerifiedAt",
          "statusReason",
          "createdAt",
          "updatedAt"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@gmail.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "example": "abc@123",
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "accountRole": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EAccountRole"
              }
            ]
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EAccountStatus"
              }
            ]
          }
        },
        "required": [
          "id",
          "email",
          "accountRole",
          "status"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT bearer token"
          },
          "account": {
            "$ref": "#/components/schemas/AuthResponseDto"
          }
        },
        "required": [
          "access_token",
          "account"
        ]
      }
    }
  }
}