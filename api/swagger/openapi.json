{
  "openapi": "3.0.0",
  "paths": {
    "/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "LoginResponseDto for brand/creator, LoginPendingResponseDto for admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Wrong email or password"
          },
          "403": {
            "description": "Account is suspended, banned, or OTP is locked"
          }
        },
        "summary": "Log in. Admin accounts receive an OTP instead of a token; other roles get the token directly",
        "tags": [
          "Auth"
        ]
      }
    },
    "/verify-otp": {
      "post": {
        "operationId": "AuthController_verifyOtp",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyOtpDto"
              }
            }
          }
