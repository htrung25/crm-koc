                }
              }
            }
          },
          "401": {
            "description": "Email is not an admin account"
          },
          "403": {
            "description": "OTP is locked"
          },
          "429": {
            "description": "Cooldown has not elapsed yet"
          }
        },
        "summary": "Send a new login OTP, subject to a cooldown",
        "tags": [
          "Auth"
        ]
      }
    },
