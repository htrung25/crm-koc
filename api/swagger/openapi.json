  "info": {
    "title": "CRM KOC API",
    "description": "REST API for the CRM KOC system",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@gmail.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "example": "abc@123",
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "EAccountRole": {
        "type": "string",
        "enum": [
          "admin",
          "brand",
          "creator"
        ]
      },
      "EAccountStatus": {
        "type": "number",
        "enum": [
          1,
          2,
          3,
          4
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "accountRole": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EAccountRole"
              }
            ]
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EAccountStatus"
              }
            ]
          }
        },
        "required": [
          "id",
          "email",
          "accountRole",
          "status"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT bearer token"
          },
          "account": {
            "$ref": "#/components/schemas/AuthResponseDto"
          }
        },
        "required": [
          "access_token",
          "account"
        ]
      },
      "VerifyOtpDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@example.com"
          },
          "otp": {
            "type": "string",
            "example": "384921"
          }
        },
        "required": [
          "email",
          "otp"
        ]
      },
      "ResendOtpDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "LoginPendingResponseDto": {
        "type": "object",
        "properties": {
          "requireOtp": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "OTP has been sent to your email"
          }
        },
        "required": [
          "requireOtp",
          "message"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Huu Trung",
            "maxLength": 255
          },
          "email": {
            "type": "string",
            "example": "admin@gmail.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "example": "abc@123",
            "minLength": 6,
            "format": "password"
          },
          "phone": {
            "type": "string",
            "example": "0900000001",
            "maxLength": 20,
            "description": "Vietnamese number. Accepts 0xxxxxxxxx / 84xxxxxxxxx / +84xxxxxxxxx and is normalized to E.164 (+84xxxxxxxxx) before saving."
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "RegisterResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "accountRole": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EAccountRole"
              }
            ]
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EAccountStatus"
              }
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "emailVerifiedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "phoneVerifiedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "statusReason": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "accountRole",
          "status",
          "name",
          "phone",
          "emailVerifiedAt",
          "phoneVerifiedAt",
          "statusReason",
          "createdAt",
          "updatedAt"
        ]
      },
      "EAccountSortField": {
        "type": "string",
        "enum": [
          "createdAt",
          "updatedAt",
          "name",
          "email",
          "status"
        ]
      },
      "ESortOrder": {
        "type": "string",
        "enum": [
          "ASC",
          "DESC"
        ]
      },
      "AdminResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "accountRole": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EAccountRole"
              }
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/EAccountStatus"
              }
            ]
          },
          "statusReason": {
            "type": "string",
            "nullable": true
          },
          "emailVerifiedAt": {
            "type": "string",
            "nullable": true,
